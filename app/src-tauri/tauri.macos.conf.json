{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agendar",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "visible": true,
        "center": true,
        "url": "index.html",
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 22,
          "y": 26
        }
      },
      {
        "label": "popover",
        "title": "Agendar",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
